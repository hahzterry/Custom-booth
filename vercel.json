{
  "rewrites": [
    {
      "source": "/photobooth",
      "destination": "/index.html"
    },
    {
      "source": "/photobooth/",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/business",
      "destination": "/index.html"
    },
    {
      "source": "/business/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
